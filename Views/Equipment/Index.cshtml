@model IReadOnlyList<HelpdeskApp.Models.Equipment>

@{
    ViewData["Title"] = "Įrangos valdymas";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Inventorius</p>
        <h1 class="h2 mb-0">Įrangos valdymas</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">Pridėti naują įrenginį</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border text-center text-muted" role="status">Įrenginių nėra.</div>
}
else
{
    <section class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h2 class="h5 mb-0">Visa įranga</h2>
            <span class="badge rounded-pill text-bg-primary">@Model.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pavadinimas</th>
                        <th>Inventoriaus numeris</th>
                        <th>Vieta</th>
                        <th>Veiksmai</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.InventoryNumber</td>
                            <td>@item.Location</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Redaguoti</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Ištrinti</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
