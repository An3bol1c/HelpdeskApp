@model HelpdeskApp.Models.EquipmentEditViewModel

@{
    ViewData["Title"] = "Redaguoti įrenginį";
}

<div class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Inventorius</p>
    <h1 class="h2 mb-0">Redaguoti įrenginį</h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm">
    <div class="card-body p-4">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Įrenginio pavadinimas</label>
        <input asp-for="Name" class="form-control" maxlength="100" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="InventoryNumber" class="form-label">Inventoriaus numeris</label>
        <input asp-for="InventoryNumber" class="form-control" readonly />
        <div class="form-text">Inventoriaus numerio keisti negalima.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label">Vieta</label>
        <input asp-for="Location" class="form-control" required />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Išsaugoti pakeitimus</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Atšaukti</a>
    </div>
    </div>
</form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
