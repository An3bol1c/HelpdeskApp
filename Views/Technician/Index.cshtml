@model IReadOnlyList<HelpdeskApp.Models.TicketListItemViewModel>

@{
    ViewData["Title"] = "IT skydelis";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Techniko darbo vieta</p>
        <h1 class="h2 mb-0">Naujausi aktyvūs gedimai</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Technician" asp-action="Tickets" class="btn btn-primary">Gedimai</a>
        <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary">Įrangos valdymas</a>
    </div>
</div>

<section class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="h5 mb-0">Aktyvių gedimų eilė</h2>
        <span class="badge rounded-pill text-bg-primary">@Model.Count</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">Aktyvių gedimų nėra.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pavadinimas</th>
                        <th>Užregistravo</th>
                        <th>Būsena</th>
                        <th>Prioritetas</th>
                        <th>Kategorija</th>
                        <th>Įranga</th>
                        <th>Sukurta</th>
                        <th>Veiksmai</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var ticket = item.Ticket;
                        <tr>
                            <td class="fw-semibold">@ticket.Title</td>
                            <td>@item.ReporterEmail</td>
                            <td><span class="badge text-bg-warning">@ticket.Status</span></td>
                            <td><span class="badge text-bg-secondary">@ticket.Priority</span></td>
                            <td>@ticket.Category?.Name</td>
                            <td>@ticket.Equipment?.Name</td>
                            <td class="text-nowrap">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary text-nowrap">Peržiūrėti</a>
                                    <form asp-controller="Tickets"
                                          asp-action="Resolve"
                                          asp-route-id="@ticket.Id"
                                          asp-route-returnUrl="@Url.Action("Index", "Technician")"
                                          method="post">
                                        <button type="submit" class="btn btn-sm btn-success text-nowrap">Išspręsta</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>