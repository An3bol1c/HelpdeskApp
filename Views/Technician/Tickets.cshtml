@model HelpdeskApp.Models.TicketBrowseViewModel

@{
    ViewData["Title"] = "Gedimai";

    string TicketsUrl(string status, string? sortColumn = null)
    {
        var targetSortBy = sortColumn ?? Model.SortBy;
        var targetSortDirection = sortColumn == null
            ? Model.SortDirection
            : Model.NextSortDirection(sortColumn);

        return Url.Action("Tickets", "Technician", new
        {
            status,
            search = Model.Search,
            reporterId = Model.ReporterId,
            categoryId = Model.CategoryId,
            equipmentId = Model.EquipmentId,
            priority = Model.Priority,
            fromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
            toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
            sortBy = targetSortBy,
            sortDirection = targetSortDirection
        }) ?? "#";
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Darbo eilė</p>
        <h1 class="h2 mb-0">Gedimai</h1>
    </div>
</div>

<div class="btn-group mb-4" role="group" aria-label="Gedimų būsena">
    @if (Model.ActiveCount > 0)
    {
        <a href="@TicketsUrl("active")"
           class="btn @(Model.Status == "active" ? "btn-primary" : "btn-outline-primary")">
            Visi aktyvūs gedimai (@Model.ActiveCount)
        </a>
    }
    @if (Model.ClosedCount > 0)
    {
        <a href="@TicketsUrl("closed")"
           class="btn @(Model.Status == "closed" ? "btn-primary" : "btn-outline-primary")">
            Visi išspręsti gedimai (@Model.ClosedCount)
        </a>
    }
</div>

<form asp-action="Tickets" method="get" class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <input type="hidden" name="status" value="@Model.Status" />
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

    <div class="row g-3">
    <div class="col-md-3">
        <label for="search" class="form-label">Pavadinimas arba aprašymas</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="reporterId" class="form-label">Vartotojas</label>
        <select id="reporterId" name="reporterId" class="form-select">
            <option value="">Visi vartotojai</option>
            @foreach (var reporter in Model.Reporters)
            {
                <option value="@reporter.Value" selected="@reporter.Selected">@reporter.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="categoryId" class="form-label">Kategorija</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">Visos kategorijos</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Value" selected="@category.Selected">@category.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="equipmentId" class="form-label">Įranga</label>
        <select id="equipmentId" name="equipmentId" class="form-select">
            <option value="">Visa įranga</option>
            @foreach (var item in Model.Equipment)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="priority" class="form-label">Prioritetas</label>
        <select id="priority" name="priority" class="form-select">
            <option value="">Visi prioritetai</option>
            @foreach (var item in Model.Priorities)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="fromDate" class="form-label">Nuo datos</label>
        <input id="fromDate"
               name="fromDate"
               type="date"
               value="@Model.FromDate?.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>
    <div class="col-md-2">
        <label for="toDate" class="form-label">Iki datos</label>
        <input id="toDate"
               name="toDate"
               type="date"
               value="@Model.ToDate?.ToString("yyyy-MM-dd")"
               class="form-control" />
    </div>
    <div class="col-12">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <button type="submit" class="btn btn-primary">Filtruoti</button>
        <a asp-action="Tickets" asp-route-status="@Model.Status" class="btn btn-outline-secondary">Išvalyti filtrus</a>
    </div>
    </div>
  </div>
</form>

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-light border text-center text-muted" role="status">Pagal pasirinktus filtrus gedimų nerasta.</div>
}
else
{
    <section class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h2 class="h5 mb-0">Rezultatai</h2>
            <span class="badge rounded-pill text-bg-primary">@Model.Tickets.Count</span>
        </div>
        <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>
                    <a href="@TicketsUrl(Model.Status, "title")">Pavadinimas @Model.SortIndicator("title")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("title")</span>
                </th>
                <th>
                    <a href="@TicketsUrl(Model.Status, "reporter")">Užregistravo @Model.SortIndicator("reporter")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("reporter")</span>
                </th>
                <th>Būsena <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("status")</span></th>
                <th>
                    <a href="@TicketsUrl(Model.Status, "priority")">Prioritetas @Model.SortIndicator("priority")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("priority")</span>
                </th>
                <th>
                    <a href="@TicketsUrl(Model.Status, "category")">Kategorija @Model.SortIndicator("category")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("category")</span>
                </th>
                <th>
                    <a href="@TicketsUrl(Model.Status, "equipment")">Įranga @Model.SortIndicator("equipment")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("equipment")</span>
                </th>
                <th>
                    <a href="@TicketsUrl(Model.Status, "created")">Sukurta @Model.SortIndicator("created")</a>
                    <span class="text-primary" title="Filtras aktyvus">@Model.FilterIndicator("created")</span>
                </th>
                <th>Veiksmai</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Tickets)
            {
                var ticket = item.Ticket;
                <tr>
                    <td class="fw-semibold">@ticket.Title</td>
                    <td>@item.ReporterEmail</td>
                    <td><span class="badge @(Model.Status == "active" ? "text-bg-warning" : "text-bg-success")">@ticket.Status</span></td>
                    <td><span class="badge text-bg-secondary">@ticket.Priority</span></td>
                    <td>@ticket.Category?.Name</td>
                    <td>@ticket.Equipment?.Name</td>
                    <td class="text-nowrap">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <div class="d-flex gap-2">
                        <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary text-nowrap">Peržiūrėti</a>
                        @if (Model.Status == "active")
                        {
                            <form asp-controller="Tickets"
                                  asp-action="Resolve"
                                  asp-route-id="@ticket.Id"
                                  asp-route-returnUrl="@TicketsUrl(Model.Status)"
                                  method="post">
                                <button type="submit" class="btn btn-sm btn-success text-nowrap">Išspręsta</button>
                            </form>
                        }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
        </div>
    </section>
}
