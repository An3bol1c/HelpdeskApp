@{
    ViewData["Title"] = "Pradžia";
}

@if (!User.Identity!.IsAuthenticated)
{
    <div class="row justify-content-center py-4">
        <div class="col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="badge rounded-pill text-bg-primary mb-2">IT Helpdesk</span>
                        <h1 class="h3 mb-2">Prisijungti</h1>
                        <p class="text-muted mb-0">Prisijunkite, kad galėtumėte valdyti savo gedimus.</p>
                    </div>
                    <form asp-area="Identity"
                          asp-page="/Account/Login"
                          asp-route-returnUrl="@Url.Action("Index", "Home")"
                          method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label">El. paštas</label>
                            <input id="email"
                                   name="Input.Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   autocomplete="username"
                                   required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Slaptažodis</label>
                            <input id="password"
                                   name="Input.Password"
                                   type="password"
                                   class="form-control form-control-lg"
                                   autocomplete="current-password"
                                   required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">Prisijungti</button>
                    </form>
                    <p class="text-center text-muted mt-4 mb-0">
                        Neturite paskyros?
                        <a asp-area="Identity" asp-page="/Account/Register" class="link-primary">Registruotis</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary btn-lg">
        Registruoti gedimą
    </a>
}