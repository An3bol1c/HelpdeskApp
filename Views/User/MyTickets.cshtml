@model IReadOnlyList<HelpdeskApp.Models.Ticket>

@{
    ViewData["Title"] = "Mano gedimai";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Vartotojo skydelis</p>
        <h1 class="h2 mb-0">Visi mano gedimai</h1>
    </div>
    <a asp-controller="User" asp-action="CreateTicket" class="btn btn-primary">Registruoti gedimą</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border text-center text-muted" role="status">Dar nesate užregistravę gedimų.</div>
}
else
{
    <section class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h2 class="h5 mb-0">Gedimų istorija</h2>
            <span class="badge rounded-pill text-bg-primary">@Model.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pavadinimas</th>
                        <th>Būsena</th>
                        <th>Prioritetas</th>
                        <th>Kategorija</th>
                        <th>Įranga</th>
                        <th>Sukurta</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@ticket.Title</td>
                            <td><span class="badge @(ticket.Status == "Closed" ? "text-bg-success" : "text-bg-warning")">@ticket.Status</span></td>
                            <td><span class="badge text-bg-secondary">@ticket.Priority</span></td>
                            <td>@ticket.Category?.Name</td>
                            <td>@ticket.Equipment?.Name</td>
                            <td class="text-nowrap">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Peržiūrėti</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}