@model IEnumerable<HelpdeskApp.Models.TicketListItemViewModel>

@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">IT Helpdesk</p>
        <h1 class="h2 mb-0">Gedimai</h1>
    </div>
</div>

<section class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="h5 mb-0">Visi gedimai</h2>
        <span class="badge rounded-pill text-bg-primary">@Model.Count()</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pavadinimas</th>
                    <th>Užregistravo</th>
                    <th>Prioritetas</th>
                    <th>Būsena</th>
                    <th>Kategorija</th>
                    <th>Įranga</th>
                    <th>Veiksmai</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">Gedimų nėra.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var ticket = item.Ticket;
                        <tr>
                            <td class="fw-semibold">@ticket.Title</td>
                            <td>@item.ReporterEmail</td>
                            <td><span class="badge text-bg-secondary">@ticket.Priority</span></td>
                            <td><span class="badge @(ticket.Status == "Closed" ? "text-bg-success" : "text-bg-warning")">@ticket.Status</span></td>
                            <td>@ticket.Category?.Name</td>
                            <td>@ticket.Equipment?.Name</td>
                            <td><a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary">Peržiūrėti</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>