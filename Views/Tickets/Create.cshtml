
@using HelpdeskApp.Models

@{
    ViewData["Title"] = "Create Ticket";
}

<h1>Create Support Ticket</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input id="title" name="Title" type="text"
               class="form-control" maxlength="150" required
               value="@ViewData.ModelState["Title"]?.AttemptedValue" />
        @Html.ValidationMessage("Title", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="Description"
                  class="form-control" rows="4">@ViewData.ModelState["Description"]?.AttemptedValue</textarea>
    </div>

    <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="CategoryId" class="form-select" required>
            <option value="">Select category</option>
            @foreach (var category in (IEnumerable<Category>)ViewBag.Categories)
            {
                if (ViewData.ModelState["CategoryId"]?.AttemptedValue == category.Id.ToString())
                {
                    <option value="@category.Id" selected>@category.Name</option>
                }
                else
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>
        @Html.ValidationMessage("CategoryId", null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="equipment" class="form-label">Equipment</label>
        <select id="equipment" name="EquipmentId" class="form-select" required>
            <option value="">Select equipment</option>
            @foreach (var equipment in (IEnumerable<Equipment>)ViewBag.Equipment)
            {
                if (ViewData.ModelState["EquipmentId"]?.AttemptedValue == equipment.Id.ToString())
                {
                    <option value="@equipment.Id" selected>@equipment.Name</option>
                }
                else
                {
                    <option value="@equipment.Id">@equipment.Name</option>
                }
            }
        </select>
        @Html.ValidationMessage("EquipmentId", null, new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Registruoti gedimą</button>
</form>
