
@using HelpdeskApp.Models

@{
    ViewData["Title"] = "Create Ticket";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <p class="text-uppercase text-primary fw-semibold small mb-1">IT Helpdesk</p>
            <h1 class="h2 mb-0">Registruoti gedimą</h1>
        </div>
        <form asp-action="Create" method="post" class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label for="title" class="form-label">Pavadinimas</label>
                    <input id="title" name="Title" type="text"
                           class="form-control" maxlength="50" required
                           value="@ViewData.ModelState["Title"]?.AttemptedValue" />
                    <div class="form-text">Iki 50 simbolių.</div>
                    @Html.ValidationMessage("Title", null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Aprašymas</label>
                    <textarea id="description" name="Description"
                              class="form-control" rows="4" maxlength="500">@ViewData.ModelState["Description"]?.AttemptedValue</textarea>
                    <div class="form-text">Iki 500 simbolių.</div>
                    @Html.ValidationMessage("Description", null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Kategorija</label>
                    <select id="category" name="CategoryId" class="form-select" required>
                        <option value="">Pasirinkite kategoriją</option>
                        @foreach (var category in (IEnumerable<Category>)ViewBag.Categories)
                        {
                            if (ViewData.ModelState["CategoryId"]?.AttemptedValue == category.Id.ToString())
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                    @Html.ValidationMessage("CategoryId", null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="equipment" class="form-label">Įranga</label>
                    <select id="equipment" name="EquipmentId" class="form-select" required>
                        <option value="">Pasirinkite įrangą</option>
                        @foreach (var equipment in (IEnumerable<Equipment>)ViewBag.Equipment)
                        {
                            if (ViewData.ModelState["EquipmentId"]?.AttemptedValue == equipment.Id.ToString())
                            {
                                <option value="@equipment.Id" selected>@equipment.Name</option>
                            }
                            else
                            {
                                <option value="@equipment.Id">@equipment.Name</option>
                            }
                        }
                    </select>
                    @Html.ValidationMessage("EquipmentId", null, new { @class = "text-danger" })
                </div>

                <div class="d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">Registruoti gedimą</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Atšaukti</a>
                </div>
            </div>
        </form>
    </div>
</div>
