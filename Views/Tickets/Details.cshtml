
@model HelpdeskApp.Models.Ticket

@{
    ViewData["Title"] = "Gedimo informacija";
}

<h1>Gedimo informacija</h1>

<div class="card mt-3">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <hr />

        <p><strong>Aprašymas:</strong> @Model.Description</p>
        <p><strong>Prioritetas:</strong> @Model.Priority</p>
        <p><strong>Būsena:</strong> @Model.Status</p>
        <p><strong>Kategorija:</strong> @Model.Category?.Name</p>
        <p><strong>Įranga:</strong> @Model.Equipment?.Name</p>
        <p><strong>Sukurta:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">
    Grįžti į gedimų sąrašą
</a>
