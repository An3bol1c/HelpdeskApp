@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 text-danger">Įvyko klaida</h1>
                <p class="text-muted">Apdorojant jūsų užklausą įvyko klaida.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="mb-0">
                        <strong>Užklausos ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="alert alert-info mt-4 mb-0" role="note">
                    Kūrimo aplinka gali rodyti išsamią klaidų informaciją. Nenaudokite jos veikiančioje sistemoje,
                    nes klaidų pranešimuose gali būti atskleista jautri informacija.
                </div>
            </div>
        </div>
    </div>
</div>
